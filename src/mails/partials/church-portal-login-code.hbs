<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <div style="text-align: center; margin-bottom: 30px;">
    <h1 style="margin: 0; color: #1F2A22; font-size: 24px; line-height: 130%; font-weight: 600;">
      Your sign-in code
    </h1>
  </div>

  <div style="text-align: left; font-size: 15px; line-height: 150%; color: #000; margin: 20px 0;">
    <p style="margin: 0;">
      Hello <strong>{{name}}</strong>, use this code to finish signing in to the
      <strong>{{churchName}}</strong> church portal:
    </p>
  </div>

  <div style="background: #f8f9fa; border: 2px solid #e9ecef; border-radius: 8px; padding: 20px; text-align: center; margin: 20px 0;">
    <div style="margin-bottom: 10px; font-size: 14px; color: #666; font-weight: 500;">Your sign-in code</div>
    <span
      style="font-weight: 600; font-size: 32px; color: #3A5A40; letter-spacing: 4px; display: inline-block; padding: 12px 0;"
    >{{otp}}</span>
  </div>

  <div style="background: #fff3cd; border: 1px solid #ffeaa7; border-radius: 6px; padding: 16px; margin: 20px 0;">
    <p style="font-size: 14px; color: #856404; margin: 0;">
      <strong>⏰ Important:</strong> This code expires in {{expiryMinutes}} minutes and stops working after
      a few wrong tries.
    </p>
  </div>

  <div style="background: #EEF3EC; border: 1px solid #CFDDCA; border-radius: 6px; padding: 16px; margin: 20px 0;">
    <p style="font-size: 14px; color: #35502F; margin: 0;">
      <strong>🔒 Didn't try to sign in?</strong> Someone may know your password. Don't share this code, and
      reset your password from the portal's sign-in page.
    </p>
  </div>

  <div style="font-size: 14px; color: #000; margin: 10px 0;">
    <p style="margin: 0;">Warm regards,<br /><strong>Spiriment Team</strong></p>
  </div>
</div>
