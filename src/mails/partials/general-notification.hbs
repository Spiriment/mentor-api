<h2
  style="text-align: center; color: #222; font-size: 24px; margin: 0 0 18px 0; letter-spacing: 0.5px;"
>{{subject}}</h2>
<p
  style="color: #444; font-size: 16px; margin: 0 0 18px 0; text-align: left;"
>Hi <strong>{{userName}}</strong>,</p>
<div
  style="background: #f7fafc; border-radius: 8px; padding: 20px 18px; margin: 0 0 24px 0; text-align: center; font-size: 17px; color: #333; line-height: 1.7;"
>
  {{message}}
</div>
<p style="font-size: 15px; color: #555; text-align: left; margin: 0 0 18px 0;">
  Open the Spiriment app to see the full details and take any next steps.
</p>
<div style="text-align: center; margin: 32px 0 18px 0;">
  <a
    href="mailto:support@spiriment.com"
    style="background: #3A5A40; color: #fff; text-decoration: none; padding: 12px 32px; border-radius: 6px; font-weight: 600; font-size: 16px; display: inline-block;"
  >Contact Support</a>
</div>