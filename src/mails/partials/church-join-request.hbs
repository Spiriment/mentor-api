<div style="font-family: 'Poppins', Arial, sans-serif;">
  <div style="text-align: center; margin-bottom: 30px;">
    <h1 style="margin: 0; color: #282828; font-size: 25px; line-height: 200%; font-weight: 700;">
      <strong>New request to join {{churchName}}</strong>
    </h1>
  </div>

  <div style="text-align: left; font-size: 15px; line-height: 150%; color: #000; margin: 20px 0;">
    <p style="margin: 0 0 12px 0;">Hello <strong>{{name}}</strong>,</p>
    <p style="margin: 0;">
      <strong>{{requesterName}}</strong> asked to join <strong>{{churchName}}</strong> on Spiriment.
      {{#if hasSeveralPending}}You have <strong>{{pendingCount}} requests</strong> waiting for review.{{/if}}
    </p>
  </div>

  <div style="text-align: center; margin: 32px 0;">
    <a
      href="{{reviewUrl}}"
      style="background: #3A5A40; color: #fff; text-decoration: none; padding: 12px 32px; border-radius: 6px; font-weight: 600; font-size: 16px; display: inline-block;"
    >Review join requests</a>
  </div>

  <div style="font-size: 13px; color: #555; margin: 20px 0;">
    <p style="margin: 0;">
      Approved members get the church discount and appear in your portal. To avoid filling your inbox,
      we send at most one of these emails per hour.
    </p>
  </div>

  <div style="font-size: 14px; color: #000; margin: 10px 0;">
    <p style="margin: 0;">Warm regards,<br /><strong>Spiriment Team</strong></p>
  </div>
</div>
